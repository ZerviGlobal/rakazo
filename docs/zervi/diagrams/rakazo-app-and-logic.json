  "diagram1": {
    "name": "Deployment architecture",
    "boundaries": [
      { "id": "employee", "label": "Employee", "colour": "grey" },
      { "id": "host", "label": "ZBOX host · tailnet 100.74.72.109 · HTTP only", "colour": "grey" },
      { "id": "appnet", "label": "docker network rakazo_app · 10.0.5.0/24", "colour": "green" },
      { "id": "perbot", "label": "per-bot network, egress restricted", "colour": "green" },
      { "id": "external", "label": "Outside Zervi", "colour": "grey" }
    ],
    "nodes": [
      { "id": "phone", "label": "Phone / desktop browser", "in": "employee", "colour": "grey" },
      { "id": "web", "label": "web  :5173\nVite + React + Thai", "in": "host", "colour": "blue" },
      { "id": "api", "label": "api  :3100\nFastify + oRPC", "in": "host", "colour": "green" },
      { "id": "worker", "label": "worker\nGraphile job runner", "in": "appnet", "colour": "green" },
      { "id": "pg", "label": "postgres", "in": "appnet", "colour": "amber" },
      { "id": "sup", "label": "supervisor\ncreates + adopts bot containers", "in": "appnet", "colour": "green" },
      { "id": "bot", "label": "bot container\ncomputer:edge\n(Xvfb + Chromium + tools)", "in": "perbot", "colour": "green" },
      { "id": "vol", "label": "volume rakazo_appdata\nhomes/team-<id> per bot", "in": "appnet", "colour": "amber" },
      { "id": "llm", "label": "model provider\n(deepseek / OpenAI-compatible)", "in": "external", "colour": "grey" }
    ],
    "edges": [
      { "from": "phone", "to": "web", "label": "HTTPS? no — plain HTTP", "colour": "red" },
      { "from": "web", "to": "api", "label": "/rpc proxy, xfwd:true", "colour": "blue" },
      { "from": "api", "to": "pg", "label": "reads/writes" },
